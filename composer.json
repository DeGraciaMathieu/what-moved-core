{
    "name": "degraciamathieu/what-moved-core",
    "type": "project",
    "description": "Analysis of what-moved: maps what a pull request moved among PHP classes and their dependencies",
    "require": {
        "degraciamathieu/php-dep": "^3.0"
    },
    "require-dev": {
        "pestphp/pest": "^3.8"
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "test": "pest",
        "test:real": "pest --group=real"
    },
    "config": {
        "allow-plugins": {
            "pestphp/pest-plugin": true
        }
    },
    "repositories": [{
        "name": "php-dep",
        "type": "vcs",
        "url": "https://github.com/DeGraciaMathieu/php-dep"
    }]
}
